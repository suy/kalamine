// ┃ ⇧    ┃  ** │   á │   â │   ç │   ã │   õ │   ñ │   ì │  *¸ │   œ │   ¿ ┃ ⇧             ┃
// ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴─┲━━━┷━━━┳━┷━━━━━╋━━━━━━━┳━━━━━━━┫
// ┃       ┃       ┃       ┃                                ┃       ┃       ┃       ┃       ┃
// ┃ Ctrl  ┃ super ┃ Alt   ┃ ␣                              ┃ AltGr ┃ super ┃ menu  ┃ Ctrl  ┃
// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛

partial alphanumeric_keys modifier_keys
xkb_symbols "standard" {
    name[group1]= "Southern European letters and symbols on a US QWERTY layout";
    key.type[group1] = "EIGHT_LEVEL";

    // Digits
    key <AE01> {[ 1               , exclam          , exclamdown      , dead_abovedot   , VoidSymbol      , VoidSymbol      ]}; // 1 ! ¡ ˙
    key <AE02> {[ 2               , at              , ordfeminine     , dead_doubleacute, VoidSymbol      , VoidSymbol      ]}; // 2 @ ª ˝
    key <AE03> {[ 3               , numbersign      , masculine       , dead_macron     , VoidSymbol      , VoidSymbol      ]}; // 3 # º ˉ
    key <AE04> {[ 4               , dollar          , cent            , yen             , VoidSymbol      , VoidSymbol      ]}; // 4 $ ¢ ¥
    key <AE05> {[ 5               , percent         , EuroSign        , sterling        , VoidSymbol      , VoidSymbol      ]}; // 5 % € £
    key <AE06> {[ 6               , asciicircum     , dead_circumflex , dead_caron      , VoidSymbol      , VoidSymbol      ]}; // 6 ^ ^ ˇ
    key <AE07> {[ 7               , ampersand       , U201E           , U201A           , VoidSymbol      , VoidSymbol      ]}; // 7 & „ ‚
    key <AE08> {[ 8               , asterisk        , ssharp          , dead_greek      , VoidSymbol      , VoidSymbol      ]}; // 8 * ß µ
    key <AE09> {[ 9               , parenleft       , U201C           , U2018           , VoidSymbol      , VoidSymbol      ]}; // 9 ( “ ‘
    key <AE10> {[ 0               , parenright      , U201D           , U2019           , VoidSymbol      , VoidSymbol      ]}; // 0 ) ” ’

    // Letters, first row
    key <AD01> {[ q               , Q               , aring           , Aring           , VoidSymbol      , VoidSymbol      ]}; // q Q å Å
    key <AD02> {[ w               , W               , ae              , AE              , VoidSymbol      , VoidSymbol      ]}; // w W æ Æ
    key <AD03> {[ e               , E               , ediaeresis      , Ediaeresis      , VoidSymbol      , VoidSymbol      ]}; // e E ë Ë
    key <AD04> {[ r               , R               , egrave          , Egrave          , VoidSymbol      , VoidSymbol      ]}; // r R è È
    key <AD05> {[ t               , T               , ooblique        , Ooblique        , VoidSymbol      , VoidSymbol      ]}; // t T ø Ø
    key <AD06> {[ y               , Y               , ugrave          , Ugrave          , VoidSymbol      , VoidSymbol      ]}; // y Y ù Ù
    key <AD07> {[ u               , U               , udiaeresis      , Udiaeresis      , VoidSymbol      , VoidSymbol      ]}; // u U ü Ü
    key <AD08> {[ i               , I               , idiaeresis      , Idiaeresis      , VoidSymbol      , VoidSymbol      ]}; // i I ï Ï
    key <AD09> {[ o               , O               , odiaeresis      , Odiaeresis      , VoidSymbol      , VoidSymbol      ]}; // o O ö Ö
    key <AD10> {[ p               , P               , ograve          , Ograve          , VoidSymbol      , VoidSymbol      ]}; // p P ò Ò

    // Letters, second row
    key <AC01> {[ a               , A               , adiaeresis      , Adiaeresis      , VoidSymbol      , VoidSymbol      ]}; // a A ä Ä
    key <AC02> {[ s               , S               , agrave          , Agrave          , VoidSymbol      , VoidSymbol      ]}; // s S à À
    key <AC03> {[ d               , D               , eacute          , Eacute          , VoidSymbol      , VoidSymbol      ]}; // d D é É
    key <AC04> {[ f               , F               , ecircumflex     , Ecircumflex     , VoidSymbol      , VoidSymbol      ]}; // f F ê Ê
    key <AC05> {[ g               , G               , icircumflex     , Icircumflex     , VoidSymbol      , VoidSymbol      ]}; // g G î Î
    key <AC06> {[ h               , H               , ucircumflex     , Ucircumflex     , VoidSymbol      , VoidSymbol      ]}; // h H û Û
    key <AC07> {[ j               , J               , uacute          , Uacute          , VoidSymbol      , VoidSymbol      ]}; // j J ú Ú
    key <AC08> {[ k               , K               , iacute          , Iacute          , VoidSymbol      , VoidSymbol      ]}; // k K í Í
    key <AC09> {[ l               , L               , oacute          , Oacute          , VoidSymbol      , VoidSymbol      ]}; // l L ó Ó
    key <AC10> {[ semicolon       , colon           , ocircumflex     , Ocircumflex     , VoidSymbol      , VoidSymbol      ]}; // ; : ô Ô

    // Letters, third row
    key <AB01> {[ z               , Z               , aacute          , Aacute          , VoidSymbol      , VoidSymbol      ]}; // z Z á Á
    key <AB02> {[ x               , X               , acircumflex     , Acircumflex     , VoidSymbol      , VoidSymbol      ]}; // x X â Â
    key <AB03> {[ c               , C               , ccedilla        , Ccedilla        , VoidSymbol      , VoidSymbol      ]}; // c C ç Ç
    key <AB04> {[ v               , V               , atilde          , Atilde          , VoidSymbol      , VoidSymbol      ]}; // v V ã Ã
    key <AB05> {[ b               , B               , otilde          , Otilde          , VoidSymbol      , VoidSymbol      ]}; // b B õ Õ
    key <AB06> {[ n               , N               , ntilde          , Ntilde          , VoidSymbol      , VoidSymbol      ]}; // n N ñ Ñ
    key <AB07> {[ m               , M               , igrave          , Igrave          , VoidSymbol      , VoidSymbol      ]}; // m M ì Ì
    key <AB08> {[ comma           , less            , dead_cedilla    , dead_ogonek     , VoidSymbol      , VoidSymbol      ]}; // , < ¸ ˛
    key <AB09> {[ period          , greater         , oe              , OE              , VoidSymbol      , VoidSymbol      ]}; // . > œ Œ
    key <AB10> {[ slash           , question        , questiondown    , dead_stroke     , VoidSymbol      , VoidSymbol      ]}; // / ? ¿ /

    // Pinky keys
    key <AE11> {[ minus           , underscore      , endash          , emdash          , VoidSymbol      , VoidSymbol      ]}; // - _ – —
    key <AE12> {[ equal           , plus            , degree          , dead_abovering  , VoidSymbol      , VoidSymbol      ]}; // = + ° ˚
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ bracketleft     , braceleft       , guillemotleft   , U2039           , VoidSymbol      , VoidSymbol      ]}; // [ { « ‹
    key <AD12> {[ bracketright    , braceright      , guillemotright  , U203A           , VoidSymbol      , VoidSymbol      ]}; // ] } » ›
    key <AC11> {[ apostrophe      , quotedbl        , dead_acute      , dead_diaeresis  , VoidSymbol      , VoidSymbol      ]}; // ' " ´ ¨
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ grave           , asciitilde      , dead_grave      , dead_tilde      , VoidSymbol      , VoidSymbol      ]}; // ` ~ ` ~
    key <BKSL> {[ backslash       , bar             , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; // \ |
    key <LSGT> {[ less            , greater         , ISO_Level5_Latch, notsign         , VoidSymbol      , VoidSymbol      ]}; // < > * ¬

    // Space bar
    key <SPCE> {[ space           , space           , space           , space           , asterisk        , asterisk        ]}; //         * *

    // The AltGr key is an ISO_Level3_Shift:
    include "level3(ralt_switch)"

    // The “OneDeadKey” is an ISO_Level5_Latch, which is activated by this:
    // (note: MDSW [Mode_switch] is an alias for LVL5 on recent versions of XKB)
    replace key <MDSW> {
        type[Group1] = "ONE_LEVEL",
        symbols[Group1] = [ ISO_Level5_Shift ]
    };
    modifier_map Mod3 { <MDSW> };
};
