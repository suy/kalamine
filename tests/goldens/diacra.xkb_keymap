// Southern European letters and symbols on a US QWERTY layout
//

xkb_keymap {
  xkb_keycodes      { include "evdev"    };
  xkb_types         { include "complete" };
  xkb_compatibility { include "complete" };

  // Base layer + dead key
  // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━━┓
  // │ ~   │ !   │ @   │ #   │ $   │ %   │ ^   │ &   │ *   │ (   │ )   │ _   │ +   ┃          ┃
  // │ `   │ 1   │ 2   │ 3   │ 4   │ 5   │ 6   │ 7   │ 8   │ 9   │ 0   │ -   │ =   ┃ ⌫        ┃
  // ┢━━━━━┷━━┱──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┺━━┳━━━━━━━┫
  // ┃        ┃ Q   │ W   │ E   │ R   │ T   │ Y   │ U   │ I   │ O   │ P   │ {   │ }   ┃       ┃
  // ┃ ↹      ┃     │     │     │     │     │     │     │     │     │     │ [   │ ]   ┃       ┃
  // ┣━━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓  ⏎   ┃
  // ┃         ┃ A   │ S   │ D   │ F   │ G   │ H   │ J   │ K   │ L   │ :   │ "   │ |   ┃      ┃
  // ┃ ⇬       ┃     │     │     │     │     │     │     │     │     │ ;   │ '   │ \   ┃      ┃
  // ┣━━━━━━┳━━┹──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┲━━┷━━━━━┻━━━━━━┫
  // ┃      ┃ >   │ Z   │ X   │ C   │ V   │ B   │ N   │ M   │ <   │ >   │ ?   ┃               ┃
  // ┃ ⇧    ┃ <   │     │     │     │     │     │     │     │ ,   │ .   │ /   ┃ ⇧             ┃
  // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴─┲━━━┷━━━┳━┷━━━━━╋━━━━━━━┳━━━━━━━┫
  // ┃       ┃       ┃       ┃                                ┃       ┃       ┃       ┃       ┃
  // ┃ Ctrl  ┃ super ┃ Alt   ┃ ␣                              ┃ AltGr ┃ super ┃ menu  ┃ Ctrl  ┃
  // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛

  // AltGr layer
  // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━━┓
  // │  *~ │  *˙ │  *” │  *¯ │   ¥ │   £ │  *ˇ │   ‚ │  *µ │   ‘ │   ’ │   — │  *˚ ┃          ┃
  // │  *` │   ¡ │   ª │   º │   ¢ │   € │  *^ │   „ │   ß │   “ │   ” │   – │   ° ┃ ⌫        ┃
  // ┢━━━━━┷━━┱──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┺━━┳━━━━━━━┫
  // ┃        ┃     │     │     │     │     │     │     │     │     │     │   ‹ │   › ┃       ┃
  // ┃ ↹      ┃   å │   æ │   ë │   è │   ø │   ù │   ü │   ï │   ö │   ò │   « │   » ┃       ┃
  // ┣━━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓  ⏎   ┃
  // ┃         ┃     │     │     │     │     │     │     │     │     │     │  *¨ │     ┃      ┃
  // ┃ ⇬       ┃   ä │   à │   é │   ê │   î │   û │   ú │   í │   ó │   ô │  *´ │     ┃      ┃
  // ┣━━━━━━┳━━┹──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┲━━┷━━━━━┻━━━━━━┫
  // ┃      ┃   ¬ │     │     │     │     │     │     │     │  *˛ │     │  */ ┃               ┃
  // ┃ ⇧    ┃  ** │   á │   â │   ç │   ã │   õ │   ñ │   ì │  *¸ │   œ │   ¿ ┃ ⇧             ┃
  // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴─┲━━━┷━━━┳━┷━━━━━╋━━━━━━━┳━━━━━━━┫
  // ┃       ┃       ┃       ┃                                ┃       ┃       ┃       ┃       ┃
  // ┃ Ctrl  ┃ super ┃ Alt   ┃ ␣                              ┃ AltGr ┃ super ┃ menu  ┃ Ctrl  ┃
  // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛

  partial alphanumeric_keys modifier_keys
  xkb_symbols "standard" {
    include "pc"
    include "inet(evdev)"

    // The “OneDeadKey” is an ISO_Level3_Latch, i.e. a “dead AltGr” key.
    // This is the only way to have a multi-purpose dead key with XKB.

    // The real AltGr key should be an ISO_Level5_Switch; however,
    // ISO_Level5_Switch does not work as expected when applying this layout
    // with xkbcomp, so let’s use two groups instead and make the AltGr key a
    // group selector.

    name[group1]= "Southern European letters and symbols on a US QWERTY layout";
    name[group2]= "AltGr";

    key.type[group1] = "FOUR_LEVEL";
    key.type[group2] = "TWO_LEVEL";

    // Digits
    key <AE01> {[ 1               , exclam          , VoidSymbol      , VoidSymbol      ],[ exclamdown      , dead_abovedot   ]}; // 1 !     ¡ ˙
    key <AE02> {[ 2               , at              , VoidSymbol      , VoidSymbol      ],[ ordfeminine     , dead_doubleacute]}; // 2 @     ª ˝
    key <AE03> {[ 3               , numbersign      , VoidSymbol      , VoidSymbol      ],[ masculine       , dead_macron     ]}; // 3 #     º ˉ
    key <AE04> {[ 4               , dollar          , VoidSymbol      , VoidSymbol      ],[ cent            , yen             ]}; // 4 $     ¢ ¥
    key <AE05> {[ 5               , percent         , VoidSymbol      , VoidSymbol      ],[ EuroSign        , sterling        ]}; // 5 %     € £
    key <AE06> {[ 6               , asciicircum     , VoidSymbol      , VoidSymbol      ],[ dead_circumflex , dead_caron      ]}; // 6 ^     ^ ˇ
    key <AE07> {[ 7               , ampersand       , VoidSymbol      , VoidSymbol      ],[ U201E           , U201A           ]}; // 7 &     „ ‚
    key <AE08> {[ 8               , asterisk        , VoidSymbol      , VoidSymbol      ],[ ssharp          , dead_greek      ]}; // 8 *     ß µ
    key <AE09> {[ 9               , parenleft       , VoidSymbol      , VoidSymbol      ],[ U201C           , U2018           ]}; // 9 (     “ ‘
    key <AE10> {[ 0               , parenright      , VoidSymbol      , VoidSymbol      ],[ U201D           , U2019           ]}; // 0 )     ” ’

    // Letters, first row
    key <AD01> {[ q               , Q               , VoidSymbol      , VoidSymbol      ],[ aring           , Aring           ]}; // q Q     å Å
    key <AD02> {[ w               , W               , VoidSymbol      , VoidSymbol      ],[ ae              , AE              ]}; // w W     æ Æ
    key <AD03> {[ e               , E               , VoidSymbol      , VoidSymbol      ],[ ediaeresis      , Ediaeresis      ]}; // e E     ë Ë
    key <AD04> {[ r               , R               , VoidSymbol      , VoidSymbol      ],[ egrave          , Egrave          ]}; // r R     è È
    key <AD05> {[ t               , T               , VoidSymbol      , VoidSymbol      ],[ ooblique        , Ooblique        ]}; // t T     ø Ø
    key <AD06> {[ y               , Y               , VoidSymbol      , VoidSymbol      ],[ ugrave          , Ugrave          ]}; // y Y     ù Ù
    key <AD07> {[ u               , U               , VoidSymbol      , VoidSymbol      ],[ udiaeresis      , Udiaeresis      ]}; // u U     ü Ü
    key <AD08> {[ i               , I               , VoidSymbol      , VoidSymbol      ],[ idiaeresis      , Idiaeresis      ]}; // i I     ï Ï
    key <AD09> {[ o               , O               , VoidSymbol      , VoidSymbol      ],[ odiaeresis      , Odiaeresis      ]}; // o O     ö Ö
    key <AD10> {[ p               , P               , VoidSymbol      , VoidSymbol      ],[ ograve          , Ograve          ]}; // p P     ò Ò

    // Letters, second row
    key <AC01> {[ a               , A               , VoidSymbol      , VoidSymbol      ],[ adiaeresis      , Adiaeresis      ]}; // a A     ä Ä
    key <AC02> {[ s               , S               , VoidSymbol      , VoidSymbol      ],[ agrave          , Agrave          ]}; // s S     à À
    key <AC03> {[ d               , D               , VoidSymbol      , VoidSymbol      ],[ eacute          , Eacute          ]}; // d D     é É
    key <AC04> {[ f               , F               , VoidSymbol      , VoidSymbol      ],[ ecircumflex     , Ecircumflex     ]}; // f F     ê Ê
    key <AC05> {[ g               , G               , VoidSymbol      , VoidSymbol      ],[ icircumflex     , Icircumflex     ]}; // g G     î Î
    key <AC06> {[ h               , H               , VoidSymbol      , VoidSymbol      ],[ ucircumflex     , Ucircumflex     ]}; // h H     û Û
    key <AC07> {[ j               , J               , VoidSymbol      , VoidSymbol      ],[ uacute          , Uacute          ]}; // j J     ú Ú
    key <AC08> {[ k               , K               , VoidSymbol      , VoidSymbol      ],[ iacute          , Iacute          ]}; // k K     í Í
    key <AC09> {[ l               , L               , VoidSymbol      , VoidSymbol      ],[ oacute          , Oacute          ]}; // l L     ó Ó
    key <AC10> {[ semicolon       , colon           , VoidSymbol      , VoidSymbol      ],[ ocircumflex     , Ocircumflex     ]}; // ; :     ô Ô

    // Letters, third row
    key <AB01> {[ z               , Z               , VoidSymbol      , VoidSymbol      ],[ aacute          , Aacute          ]}; // z Z     á Á
    key <AB02> {[ x               , X               , VoidSymbol      , VoidSymbol      ],[ acircumflex     , Acircumflex     ]}; // x X     â Â
    key <AB03> {[ c               , C               , VoidSymbol      , VoidSymbol      ],[ ccedilla        , Ccedilla        ]}; // c C     ç Ç
    key <AB04> {[ v               , V               , VoidSymbol      , VoidSymbol      ],[ atilde          , Atilde          ]}; // v V     ã Ã
    key <AB05> {[ b               , B               , VoidSymbol      , VoidSymbol      ],[ otilde          , Otilde          ]}; // b B     õ Õ
    key <AB06> {[ n               , N               , VoidSymbol      , VoidSymbol      ],[ ntilde          , Ntilde          ]}; // n N     ñ Ñ
    key <AB07> {[ m               , M               , VoidSymbol      , VoidSymbol      ],[ igrave          , Igrave          ]}; // m M     ì Ì
    key <AB08> {[ comma           , less            , VoidSymbol      , VoidSymbol      ],[ dead_cedilla    , dead_ogonek     ]}; // , <     ¸ ˛
    key <AB09> {[ period          , greater         , VoidSymbol      , VoidSymbol      ],[ oe              , OE              ]}; // . >     œ Œ
    key <AB10> {[ slash           , question        , VoidSymbol      , VoidSymbol      ],[ questiondown    , dead_stroke     ]}; // / ?     ¿ /

    // Pinky keys
    key <AE11> {[ minus           , underscore      , VoidSymbol      , VoidSymbol      ],[ endash          , emdash          ]}; // - _     – —
    key <AE12> {[ equal           , plus            , VoidSymbol      , VoidSymbol      ],[ degree          , dead_abovering  ]}; // = +     ° ˚
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ],[ VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ bracketleft     , braceleft       , VoidSymbol      , VoidSymbol      ],[ guillemotleft   , U2039           ]}; // [ {     « ‹
    key <AD12> {[ bracketright    , braceright      , VoidSymbol      , VoidSymbol      ],[ guillemotright  , U203A           ]}; // ] }     » ›
    key <AC11> {[ apostrophe      , quotedbl        , VoidSymbol      , VoidSymbol      ],[ dead_acute      , dead_diaeresis  ]}; // ' "     ´ ¨
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ],[ VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ grave           , asciitilde      , VoidSymbol      , VoidSymbol      ],[ dead_grave      , dead_tilde      ]}; // ` ~     ` ~
    key <BKSL> {[ backslash       , bar             , VoidSymbol      , VoidSymbol      ],[ VoidSymbol      , VoidSymbol      ]}; // \ |
    key <LSGT> {[ less            , greater         , VoidSymbol      , VoidSymbol      ],[ ISO_Level3_Latch, notsign         ]}; // < >     ' ¬

    // Space bar
    key <SPCE> {[ space           , space           , apostrophe      , apostrophe      ],[ space           , space           ]}; //     ' '

    // AltGr
    // Note: the `ISO_Level5_Latch` here is meaningless but helps with Chromium.
    key <RALT> {
      type = "TWO_LEVEL",
      symbols = [ ISO_Level5_Latch, ISO_Level5_Latch ],
      actions = [ SetGroup(group=2), SetGroup(group=2) ]
    };
  };
};
